{
  "name": "roadstar-3d-loader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev:full": "powershell -ExecutionPolicy Bypass -File scripts/free-dev-ports.ps1",
    "dev:full": "concurrently -k -n SOLVER,SIM,INTEGRATIONS,WEB -c yellow,cyan,magenta,green \"npm:solver\" \"npm:simulator\" \"npm:integrations\" \"npm:dev\"",
    "solver": "powershell -ExecutionPolicy Bypass -File services/loading-solver/run.ps1",
    "simulator": "node services/telematics-simulator/server.mjs",
    "integrations": "node services/integration-gateway/server.mjs",
    "start": "node services/web-server/server.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "quality": "powershell -ExecutionPolicy Bypass -File scripts/run-quality-gate.ps1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "6.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "5.0.0"
  }
}
