# Copy this file to .env.local after creating the Supabase project.
# These browser-safe values are available under Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only deployment configuration. Never prefix secrets with VITE_.
APP_ORIGIN=http://localhost:8080
ROUTING_PROVIDER=OSRM
ROUTING_BASE_URL=
ROUTING_API_TOKEN=
REQUIRE_ROUTING=false
# The docker-compose.osrm.yml override supplies the routing values above.
TMS_PROVIDER=
TMS_HEALTH_URL=
TMS_API_TOKEN=
ELD_PROVIDER=
ELD_HEALTH_URL=
ELD_API_TOKEN=
TELEMATICS_URL=

# RoadStar AI (SPUR Compute). Server-only: read by the integration gateway and
# never compiled into the browser bundle. Put the real key in .env.
SPUR_API_KEY=
SPUR_BASE_URL=https://ai.spuric.com/v1
SPUR_MODEL_EXTRACT=spur-glm-5-2
SPUR_MODEL_VISION=spur-vision
SPUR_MODEL_COPILOT=spur-glm-5-2
SPUR_MODEL_COPILOT_FALLBACK=spur-glm-air
SPUR_TIMEOUT_MS=8000
AI_RATE_LIMIT_PER_MINUTE=20
# The gateway verifies AI callers with Supabase. When these are empty it uses
# the VITE_SUPABASE_* values above, which are the same browser-safe values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
